<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bopbox_w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bopbox_widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingEnd="10dp">

    <ImageView
        android:id="@+id/bopbox_w_art"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="@string/bopbox_artwork"
        android:scaleType="centerCrop"
        android:src="@drawable/bopbox_art_placeholder" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/bopbox_w_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/bopbox_nothing_playing"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/bopbox_w_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFB6FF3B"
            android:textSize="11sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/bopbox_w_toggle"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bopbox_play_bg"
        android:contentDescription="@string/bopbox_play_pause"
        android:padding="9dp"
        android:scaleType="fitCenter"
        android:src="@drawable/bopbox_ic_play" />
</LinearLayout>
