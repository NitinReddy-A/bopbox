<?xml version="1.0" encoding="utf-8"?>
<!-- Mini player (3x1): artwork, title and status line, play/pause on the right. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bopbox_w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bopbox_bg_widget"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="8dp">

    <ImageView
        android:id="@+id/bopbox_w_art"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="@string/bopbox_artwork"
        android:scaleType="centerCrop"
        android:src="@drawable/bopbox_art_placeholder_mini" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="4dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/bopbox_w_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="@string/bopbox_not_playing"
            android:textColor="@color/bopbox_label"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/bopbox_w_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:maxLines="1"
            android:text="@string/bopbox_idle_subtitle"
            android:textColor="@color/bopbox_label_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- 44dp touch target around a 36dp accent disc (the background is inset by 4dp). -->
    <ImageButton
        android:id="@+id/bopbox_w_toggle"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bopbox_bg_play_button"
        android:contentDescription="@string/bopbox_play_pause"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:src="@drawable/bopbox_ic_play" />
</LinearLayout>
