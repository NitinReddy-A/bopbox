<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bopbox_w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bopbox_widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <ImageView
        android:id="@+id/bopbox_w_art"
        android:layout_width="84dp"
        android:layout_height="84dp"
        android:contentDescription="@string/bopbox_artwork"
        android:scaleType="centerCrop"
        android:src="@drawable/bopbox_art_placeholder" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.15"
            android:text="@string/bopbox_widget_kicker"
            android:textColor="#FFFF4FD8"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/bopbox_w_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="@string/bopbox_nothing_playing"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/bopbox_w_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#B3FFFFFF"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/bopbox_w_prev"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/bopbox_previous"
                android:src="@drawable/bopbox_ic_prev" />

            <ImageButton
                android:id="@+id/bopbox_w_toggle"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bopbox_play_bg"
                android:contentDescription="@string/bopbox_play_pause"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/bopbox_ic_play" />

            <ImageButton
                android:id="@+id/bopbox_w_next"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/bopbox_next"
                android:src="@drawable/bopbox_ic_next" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
