<?xml version="1.0" encoding="utf-8"?>
<!-- Now Playing (4x2): artwork on the left; app, title, artist and transport controls on the right. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bopbox_w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bopbox_bg_widget"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="16dp">

    <ImageView
        android:id="@+id/bopbox_w_art"
        android:layout_width="76dp"
        android:layout_height="76dp"
        android:contentDescription="@string/bopbox_artwork"
        android:scaleType="centerCrop"
        android:src="@drawable/bopbox_art_placeholder" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/bopbox_w_app"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:maxLines="1"
            android:text="@string/bopbox_app_name"
            android:textColor="@color/bopbox_label_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/bopbox_w_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="2"
            android:text="@string/bopbox_not_playing"
            android:textColor="@color/bopbox_label"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/bopbox_w_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:maxLines="1"
            android:text="@string/bopbox_idle_subtitle"
            android:textColor="@color/bopbox_label_secondary"
            android:textSize="13sp" />

        <!-- 44dp+ touch targets; the negative start margin lines the first glyph up with the text. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="-10dp"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/bopbox_w_prev"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/bopbox_previous"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/bopbox_ic_prev" />

            <!-- 48dp touch target around a 40dp accent disc (the background is inset by 4dp). -->
            <ImageButton
                android:id="@+id/bopbox_w_toggle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bopbox_bg_play_button"
                android:contentDescription="@string/bopbox_play_pause"
                android:padding="13dp"
                android:scaleType="fitCenter"
                android:src="@drawable/bopbox_ic_play" />

            <ImageButton
                android:id="@+id/bopbox_w_next"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/bopbox_next"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/bopbox_ic_next" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
