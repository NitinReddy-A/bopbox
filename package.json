{
  "name": "bopbox",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "expo": "~58.0.23",
    "expo-constants": "~58.0.15",
    "expo-haptics": "~58.0.7",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.88.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "globals": "^16.5.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "test": "jest",
    "test:native": "cd android && ./gradlew :bopbox-core:testDebugUnitTest",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "prebuild": "expo prebuild -p android --clean"
  },
  "private": true,
  "jest": {
    "testTimeout": 60000,
    "projects": [
      {
        "displayName": "app",
        "preset": "jest-expo",
        "testMatch": [
          "**/__tests__/**/*.test.[jt]s?(x)"
        ],
        "testPathIgnorePatterns": [
          "/node_modules/",
          "/android/",
          "<rootDir>/modules/bopbox-core/__tests__/"
        ],
        "setupFilesAfterEnv": [
          "<rootDir>/jest.setup.ts"
        ],
        "moduleNameMapper": {
          "^@bopbox/core$": "<rootDir>/src/test/mockBopboxCore.tsx"
        }
      },
      {
        "displayName": "page-scripts",
        "testEnvironment": "jsdom",
        "testMatch": [
          "<rootDir>/modules/bopbox-core/__tests__/**/*.test.js"
        ]
      }
    ]
  }
}
